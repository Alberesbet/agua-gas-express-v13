rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // TESTE: qualquer usuário autenticado pode ler/gravar.
    // Publique estas regras no Firebase Console para que elas tenham efeito.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
